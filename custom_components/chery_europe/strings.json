{
  "config": {
    "step": {
      "user": {
        "title": "Chery Europe Setup",
        "description": "Choose how to sign in. Email is recommended. Use SMS only if your Chery Europe account is registered with a phone number instead of an email.",
        "menu_options": {
          "login_email": "Sign in with email (recommended)",
          "login_phone": "Sign in with phone number (SMS)"
        }
      },
      "login_email": {
        "title": "Sign in with email",
        "description": "Enter the email address registered in the Chery Europe app. A one-time login code will be sent to that address.",
        "data": {
          "login": "Email"
        }
      },
      "login_phone": {
        "title": "Sign in with phone (SMS)",
        "description": "Enter the phone number registered in the Chery Europe app and its country calling code in digits (Poland = 48, without +). A verification code will be sent by SMS. Prefer email login when your account has an email address.",
        "data": {
          "phone": "Phone number (without country code)",
          "area_code": "Country code in digits (e.g. 48)"
        }
      },
      "code": {
        "title": "Enter login code",
        "description": "Enter the login code sent to {destination}.",
        "data": {
          "code": "Login code"
        }
      },
      "pin": {
        "title": "Vehicle control PIN",
        "description": "Enter the PIN used in the Chery Europe app for remote commands (lock, climate, etc.). Enter it twice to confirm. It is always stored in integration options. Enable Ask for PIN if you want to confirm it again for each action.",
        "data": {
          "pin": "Vehicle PIN",
          "pin_confirm": "Confirm PIN",
          "ask_for_pin": "Ask for PIN"
        }
      },
      "reauth_confirm": {
        "title": "Reauthenticate Chery Europe",
        "description": "Send a new login code to {destination} to reauthenticate your Chery Europe account.",
        "data": {
          "login": "Email",
          "phone": "Phone number (without country code)",
          "area_code": "Country code in digits (e.g. 48)"
        }
      }
    },
    "error": {
      "invalid_auth": "Invalid or expired login code.",
      "otp_send_failed": "Could not send the login code. Check the email or phone number and try again.",
      "phone_invalid": "Invalid phone number or country code. Enter the national number without country code, and the country code in digits only (e.g. 48).",
      "captcha_failed": "Captcha verification failed. Please try again.",
      "cannot_connect": "Unable to connect to Chery Europe. Check your internet connection.",
      "rate_limit": "Rate limit exceeded. Please wait before trying again.",
      "pin_mismatch": "PIN confirmation does not match.",
      "pin_required": "PIN is required.",
      "unknown": "An unexpected error occurred. Please try again later."
    },
    "abort": {
      "already_configured": "This Chery Europe account is already configured.",
      "reauth_successful": "Reauthentication successful."
    }
  },
